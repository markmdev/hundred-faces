{
  "name": "hundred-faces",
  "version": "0.1.0",
  "private": true,
  "description": "A wall of one hundred faces that react while you type, judged by TypeSafe AI's Jev.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "server": "node server/main.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm test",
    "measure": "node scripts/measure-batching.ts",
    "record": "node scripts/record-fixture.ts",
    "probe": "node scripts/probe.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
